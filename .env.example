# Copy this file to .env and replace the placeholders with your own values.
# Never commit your real .env file to version control.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Image generation (all tiers are free; no key needed for tier 1) ---
# Tier 1 (default, no key): Pollinations.ai free REST endpoint.
#     Model: flux-realism, 1080x1080, no logo.
# Tier 2 (optional, needs GEMINI_API_KEY above): Gemini Imagen 3.0.
# Tier 3 (always available offline): local Pillow poster card.
# Set IG_IMAGE_MODEL=flux-realism (or "midjourney", "juggernaut", etc.) to
# override the Pollinations model; see https://pollinations.ai for options.

# --- Instagram Graph API publishing (optional) ---
# All four are required for automatic publishing; without them posts stay
# queued and any due post is marked "failed" at image-URL resolution.
#
# 1. IG_USER_ID: numeric Instagram Business/Creator account ID.
# 2. IG_ACCESS_TOKEN: long-lived (60-day) Graph API access token with
#    instagram_basic + instagram_content_publish permissions.
# 3. IG_PUBLIC_BASE_URL *or* IMGBB_API_KEY — Meta fetches the image from a
#    public HTTPS URL, so a local path such as data/ig_media/x.png never works.
#      - IG_PUBLIC_BASE_URL: base URL of a public host serving data/ig_media/,
#        e.g. https://cdn.example.com/ig (the file name is appended).
#      - IMGBB_API_KEY: imgbb.com API key; images are uploaded and hosted there.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_PUBLIC_BASE_URL=
IMGBB_API_KEY=

# Optional overrides
# IG_GRAPH_API_VERSION=v21.0
# IG_HANDLE=@jarvis